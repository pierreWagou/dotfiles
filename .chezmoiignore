# =============================================================================
# Chezmoi Ignore - Files to exclude from apply
# =============================================================================
# Documentation: https://www.chezmoi.io/reference/special-files-and-directories/chezmoiignore/

# Documentation files
README.md
LICENSE*
CHANGELOG*
*.md
assets/

# Version control
.git/
.gitignore
.gitattributes

# Development files
.editorconfig
.vscode/
.idea/

# Generated files
.config/nvim/lazy-lock.json

# Plugin directories (managed by their respective plugin managers)
.config/tmux/plugins/

# Chezmoi's own config (cannot be managed directly, use templates instead)
.config/chezmoi/**

# macOS system files
.DS_Store
.localized

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Host-Conditional Ignores
# -----------------------------------------------------------------------------

# NixOS server: no GUI, no Dashlane, no macOS tools
{{ if eq .nixProfile "wagoulab" }}
.ssh/config
.config/ghostty/**
.config/spicetify/**
.config/spotify-player/**
.config/claude/**
.config/copilot/**
.config/docker/**
Library/**
{{ end }}

# SAP-only tools (not needed on personal or server hosts)
{{ if ne .nixProfile "sap" }}
.config/gh/hosts.yml
.config/git/config-sap
.config/hai/**
.config/databricks/**
{{ end }}
