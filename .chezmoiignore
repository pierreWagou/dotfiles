# =============================================================================
# Chezmoi Ignore - Files to exclude from apply
# =============================================================================
# Documentation: https://www.chezmoi.io/reference/special-files-and-directories/chezmoiignore/

# Documentation files
README.md
LICENSE*
CHANGELOG*
*.md
assets/

# Version control
.git/
.gitignore
.gitattributes

# Development files
.editorconfig
.vscode/
.idea/

# Generated files
.config/nvim/lazy-lock.json

# Plugin directories (managed by their respective plugin managers)
.config/tmux/plugins/

# Chezmoi's own config (cannot be managed directly, use templates instead)
.config/chezmoi/**

# AOE runtime data (AOE owns config.toml; we manage profile configs only)
.config/agent-of-empires/config.toml
.config/agent-of-empires/debug.log
.config/agent-of-empires/telemetry.json
.config/agent-of-empires/update_cache.json
.config/agent-of-empires/tui-presence
.config/agent-of-empires/.schema_version
.config/agent-of-empires/.recovery.lock
.config/agent-of-empires/.telemetry.lock
.config/agent-of-empires/profiles/*/sessions.json
.config/agent-of-empires/profiles/*/.storage.lock
.config/agent-of-empires/logs/

# macOS system files
.DS_Store
.localized

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Host-Conditional Ignores
# -----------------------------------------------------------------------------

# NixOS server: no GUI, no macOS tools
{{ if eq .chezmoi.os "linux" }}
.ssh/config
.config/ghostty/**
.config/spicetify/**
.config/spotify-player/**
.config/docker/**
Library/**
Projects/wagou/opencode.json
Projects/wagou/AGENTS.md
Projects/wagou/.opencode/**
{{ end }}

# Alan-only files (not needed on non-alan hosts)
{{ if and (ne .nixProfile "alan") (ne .nixProfile "alan-mac") }}
.config/lore/**
.config/claude/**
Projects/alan/opencode.json
Projects/alan/AGENTS.md
Projects/alan/.opencode/**
{{ end }}
