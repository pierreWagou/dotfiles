{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.5",
  "mcp": {
    "servers": {
      "google": {
        "type": "remote",
        "url": "TODO"
      },
      "home-assistant": {
        "type": "remote",
        "url": "https://home.wagou.fr/api/mcp",
        "oauth": {
          "client_id": "http://localhost:3119",
          "callback_port": 3119,
          "redirect_uri": "http://localhost:3119/callback"
        }
      },
      "authentik": {
        "type": "local",
        "command": ["npx", "-y", "@samik081/mcp-authentik"],
        "environment": {
          "AUTHENTIK_URL": "https://auth.wagou.fr",
          "AUTHENTIK_TOKEN": "{{ (rbwFields "Authentik").Token.value }}"
        }
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "oauth": {
          "callback_port": 3119
        }
      }
    }
  }
}
