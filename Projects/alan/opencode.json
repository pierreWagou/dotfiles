{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/alan-anthropic-sonnet-5-5#medium",
  "snapshots": false,
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/.devbox/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/.mypy_cache/**",
      "**/.pytest_cache/**",
      "**/.terraform/**",
      "**/coverage/**",
      "**/.opencode/**"
    ]
  },
  "providers": {
    "amazon-bedrock": {
      "settings": {
        "region": "eu-central-1"
      },
      "models": {
        "alan-anthropic-sonnet-5-5": {
          "modelID": "arn:aws:bedrock:eu-central-1:624118351943:application-inference-profile/0z0px5qg0ipy"
        },
        "alan-anthropic-opus-5-5": {
          "modelID": "arn:aws:bedrock:eu-central-1:624118351943:application-inference-profile/3uj47kywg0bq"
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "~/Documents/Alan/**", "effect": "allow" }
  ],
  "plugins": [
    "cc-safety-net"
  ],
  "mcp": {
    "servers": {
      "google": {
        "type": "remote",
        "url": "https://hopper-api.alan.com/mcps/google/"
      },
      "github": {
        "type": "remote",
        "url": "https://hopper-api.alan.com/mcps/github/"
      },
      "ashby": {
        "type": "remote",
        "url": "https://hopper-api.alan.com/mcps/ashby/"
      },
      "quill": {
        "type": "local",
        "command": [
          "node",
          "/Users/pierre.romon/Library/Application Support/Quill/mcp-stdio-bridge.js"
        ]
      },
      "customerio": {
        "type": "remote",
        "url": "https://mcp-eu.customer.io/mcp"
      }
    }
  }
}
