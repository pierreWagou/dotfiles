#!{{ .chezmoi.homeDir }}/.local/bin/lua

-- sketchybarrc is executed by sketchybar on start (SbarLua setup).
-- The SbarLua module itself is NOT managed here: build it once per machine
-- (SbarLua makefile needs `make posix` first on macOS for lack of readline
-- headers) into $HOME/.local/share/sketchybar_lua/ plus a `lua` interpreter
-- on PATH. Rebuild after sketchybar upgrades (Mach IPC is version-coupled).

package.cpath = package.cpath .. ";" .. os.getenv("HOME") .. "/.local/share/sketchybar_lua/?.so"

sbar = require("sketchybar")

-- Bundle the entire initial configuration into a single message to sketchybar
sbar.begin_config()
require("init")
sbar.hotload(true)
sbar.end_config()

-- Run the event loop (without this no callback runs)
sbar.event_loop()
