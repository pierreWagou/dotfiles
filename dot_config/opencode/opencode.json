{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "model": "opencode-go/mimo-v2.5",
  "permissions": [
    { "action": "external_directory", "resource": "~/.config/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/chezmoi/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/nvim/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/run/current-system/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/nix/store/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.config/**", "effect": "deny" },
    { "action": "edit", "resource": "~/Projects/wagou/wagounix/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.local/share/chezmoi/**", "effect": "allow" }
  ],
  "compaction": {
    "auto": true
  },
  "plugins": [
    "@tarquinen/opencode-dcp",
    "opencode-mermaid-renderer",
    "opencode-notify",
    "@plannotator/opencode@latest"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  }
}
