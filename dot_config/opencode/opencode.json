{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/mimo-v2.5",
  "permission": {
    "external_directory": {
      "~/.config/**": "allow",
      "~/.local/share/chezmoi/**": "allow",
      "~/.local/share/nvim/**": "allow",
      "/run/current-system/**": "allow",
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.config/**": "deny",
      "~/Projects/wagou/wagounix/**": "allow",
      "~/.local/share/chezmoi/**": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "plugin": [
    "@tarquinen/opencode-dcp",
    "opencode-mermaid-renderer",
    "opencode-notify"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
