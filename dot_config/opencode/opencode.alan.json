{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/eu.anthropic.claude-sonnet-4-6",
  "small_model": "amazon-bedrock/eu.anthropic.claude-sonnet-4-6",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-north-1"
      }
    }
  },
  "plugin": ["cc-safety-net"],
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118,
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "google": {
      "type": "remote",
      "url": "https://hopper-api.alan.com/mcps/google/"
    },
    "github": {
      "type": "remote",
      "url": "https://hopper-api.alan.com/mcps/github/"
    },
    "ashby": {
      "type": "remote",
      "url": "https://hopper-api.alan.com/mcps/ashby/"
    },
    "quill": {
      "type": "local",
      "command": ["node", "/Users/pierre.romon/Library/Application Support/Quill/mcp-stdio-bridge.js"],
      "enabled": true
    }
  }
}
