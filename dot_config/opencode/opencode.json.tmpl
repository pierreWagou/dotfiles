{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "anthropic/claude-opus-4-6",
  "small_model": "anthropic/claude-sonnet-4-6",
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://localhost:6655/anthropic/v1",
        "apiKey": "{{ (rbw "Anthropic Token").data.password }}"
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/**": "allow",
      "~/.local/share/chezmoi/**": "allow",
      "~/.local/share/nvim/**": "allow",
      "/run/current-system/**": "allow",
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.config/**": "deny",
      "~/.config/wagounix/**": "allow",
      "~/.local/share/chezmoi/**": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
