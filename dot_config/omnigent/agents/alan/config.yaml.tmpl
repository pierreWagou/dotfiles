spec_version: 1
name: alan
description: Alan health insurance company agent

prompt: |
  You are a coding agent running on the wagou home server.
  Inspect files before editing, run targeted tests,
  and summarize changes with validation results.

instructions: AGENTS.md

executor:
  type: omnigent
  config:
    harness: opencode
  model: amazon-bedrock/eu.anthropic.claude-sonnet-4-5-20250929-v1:0

os_env:
  type: caller_process
  cwd: .
  sandbox:
    type: none
tools:
  linear:
    type: mcp
    url: https://mcp.linear.app/mcp
    headers:
      Authorization: "Bearer {{ (rbwFields `Linear`).Token.value }}"
  notion:
    type: mcp
    url: https://mcp.notion.com/mcp
  slack:
    type: mcp
    url: https://mcp.slack.com/mcp
  google:
    type: mcp
    url: https://hopper-api.alan.com/mcps/google/
  github:
    type: mcp
    url: https://hopper-api.alan.com/mcps/github/
  ashby:
    type: mcp
    url: https://hopper-api.alan.com/mcps/ashby/
  quill:
    type: mcp
    command: node
    args:
      - /Users/pierre.romon/Library/Application Support/Quill/mcp-stdio-bridge.js
  customerio:
    type: mcp
    url: https://mcp-eu.customer.io/mcp
